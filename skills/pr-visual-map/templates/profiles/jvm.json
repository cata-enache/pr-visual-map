{
  "name": "jvm",
  "description": "Java / Kotlin: Spring, JAX-RS, Flyway.",
  "detect": [
    "(^|/)(pom\\.xml|build\\.gradle(\\.kts)?|settings\\.gradle(\\.kts)?)$"
  ],
  "classify": [
    {
      "order": 22,
      "kind": "test",
      "path": "Tests?\\.(java|kt|scala)$|(^|/)src/test/"
    },
    {
      "order": 30,
      "kind": "migration",
      "path": "(^|/)db/migration/|(^|/)V\\d+__[^/]+\\.sql$"
    },
    {
      "order": 50,
      "kind": "config",
      "name": "(?i)^(pom\\.xml|build\\.gradle(\\.kts)?|settings\\.gradle(\\.kts)?|application[^/]*\\.(ya?ml|properties))$"
    },
    {
      "order": 60,
      "kind": "endpoint",
      "path": "(Controller|Resource|Endpoint)\\.(java|kt)$"
    },
    {
      "order": 82,
      "kind": "entity",
      "code": true,
      "path": "(Entity|Repository)\\.(java|kt)$"
    },
    {
      "order": 84,
      "kind": "dto",
      "code": true,
      "path": "(Dto|DTO|Request|Response|Event|Message)s?\\.(java|kt)$"
    }
  ],
  "flags": [
    {
      "type": "auth",
      "re": "@PreAuthorize|@PostAuthorize|@Secured|@RolesAllowed|\\.authorizeHttpRequests|\\.permitAll\\(\\)",
      "on": "+-",
      "severity": {
        "+": "medium",
        "-": "high"
      },
      "reason": {
        "+": "Auth rule added: {line}",
        "-": "Auth rule removed or changed: {line}"
      }
    },
    {
      "type": "public-api",
      "re": "@(Get|Post|Put|Delete|Patch|Request)Mapping\\b|@Path\\(",
      "on": "+-",
      "severity": {
        "+": "medium",
        "-": "high"
      },
      "skipGenerated": true,
      "reason": {
        "+": "New HTTP route: {line}",
        "-": "HTTP route removed or changed: {line}"
      }
    },
    {
      "type": "config",
      "re": "<artifactId>([^<]+)</artifactId>",
      "on": "+-",
      "severity": "medium",
      "files": "(^|/)pom\\.xml$",
      "reason": "Package {verb}: {1} {2}"
    }
  ],
  "routes": [
    {
      "families": [
        "jvm"
      ],
      "classPrefix": "@RequestMapping\\(\\s*(?:value\\s*=\\s*|path\\s*=\\s*)?\\\"([^\\\"]*)\\\"\\s*\\)[\\s\\S]{0,400}?\\bclass\\s+(\\w+)",
      "method": "@(?:Get|Post|Put|Delete|Patch|Request)Mapping\\(\\s*(?:value\\s*=\\s*|path\\s*=\\s*)?\\\"([^\\\"]*)\\\""
    }
  ]
}
