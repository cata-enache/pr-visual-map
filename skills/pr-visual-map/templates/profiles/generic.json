{
  "name": "generic",
  "description": "Language-level rules that hold for any repository. Always active.",
  "extensions": {
    "code": [
      ".cs",
      ".fs",
      ".vb",
      ".java",
      ".kt",
      ".scala",
      ".go",
      ".py",
      ".rb",
      ".php",
      ".ts",
      ".js",
      ".mjs",
      ".cjs",
      ".rs",
      ".swift",
      ".c",
      ".cc",
      ".cpp",
      ".h",
      ".hpp",
      ".sql"
    ],
    "ui": [
      ".html",
      ".htm",
      ".scss",
      ".sass",
      ".css",
      ".less",
      ".tsx",
      ".jsx",
      ".vue",
      ".svelte",
      ".razor",
      ".cshtml",
      ".mjml",
      ".hbs",
      ".handlebars",
      ".jinja",
      ".jinja2",
      ".j2",
      ".njk",
      ".liquid",
      ".ejs",
      ".pug"
    ],
    "doc": [
      ".md",
      ".txt",
      ".rst",
      ".adoc",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".svg",
      ".drawio",
      ".puml",
      ".pdf"
    ]
  },
  "generated": {
    "path": [
      "(?i)(^|/)(generated|__generated__|autogen|auto-generated)/",
      "(?i)(^|/)(dist|build|out)/[^/]+\\.(html?|css|js|mjs|map)$"
    ],
    "suffix": [
      ".g.cs",
      ".designer.cs",
      ".generated.cs",
      ".g.i.cs",
      ".pb.go",
      "_pb2.py",
      ".min.js",
      ".min.css"
    ],
    "names": [
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lock",
      "bun.lockb",
      "packages.lock.json",
      "poetry.lock",
      "uv.lock",
      "pipfile.lock",
      "pdm.lock",
      "cargo.lock",
      "go.sum",
      "composer.lock",
      "gemfile.lock",
      "gradle.lockfile",
      "flake.lock",
      "mix.lock",
      "pubspec.lock",
      "package.resolved",
      ".terraform.lock.hcl"
    ],
    "content": "auto-?generated|do not edit|<auto-generated"
  },
  "projectMarkers": [
    "(^|/)([^/]+\\.(csproj|fsproj|vbproj|sqlproj)|package\\.json|go\\.mod|pyproject\\.toml|setup\\.py|pom\\.xml|build\\.gradle(\\.kts)?|Cargo\\.toml)$"
  ],
  "stripDirs": [
    "src",
    "app",
    "lib",
    "source",
    "main",
    "java",
    "kotlin",
    "scripts",
    "internal",
    "pkg"
  ],
  "families": {
    "dotnet": {
      "ext": [
        ".cs",
        ".fs",
        ".vb"
      ],
      "types": "\\b(?P<kw>class|interface|record|struct|enum)\\s+(?:class\\s+|struct\\s+)?(?P<name>[A-Z][A-Za-z0-9_]*)",
      "members": "^\\s*(?:\\[[^\\]]*\\]\\s*)*(?:public|internal|protected)\\s+(?:[\\w<>\\[\\],.?]+\\s+)*?(?P<name>[A-Z]\\w*)\\s*(?:<[^>]*>)?\\s*(?:\\(|\\{|=>|;|=)",
      "decl": "^\\s*(?:\\[[^\\]]*\\]\\s*)*(?:(?:public|private|protected|internal|static|async|override|virtual|sealed|abstract|partial|extern|unsafe|final|synchronized|suspend|open|fun)\\s+)+(?:[\\w<>\\[\\],.?]+\\s+)*?(?P<name>[A-Za-z_]\\w*)\\s*(?:<[^>]*>)?\\s*\\("
    },
    "jvm": {
      "ext": [
        ".java",
        ".kt",
        ".scala"
      ],
      "types": "\\b(?P<kw>class|interface|record|struct|enum)\\s+(?:class\\s+|struct\\s+)?(?P<name>[A-Z][A-Za-z0-9_]*)",
      "members": "^\\s*(?:\\[[^\\]]*\\]\\s*)*(?:public|internal|protected)\\s+(?:[\\w<>\\[\\],.?]+\\s+)*?(?P<name>[A-Z]\\w*)\\s*(?:<[^>]*>)?\\s*(?:\\(|\\{|=>|;|=)",
      "decl": "^\\s*(?:\\[[^\\]]*\\]\\s*)*(?:(?:public|private|protected|internal|static|async|override|virtual|sealed|abstract|partial|extern|unsafe|final|synchronized|suspend|open|fun)\\s+)+(?:[\\w<>\\[\\],.?]+\\s+)*?(?P<name>[A-Za-z_]\\w*)\\s*(?:<[^>]*>)?\\s*\\("
    },
    "js": {
      "ext": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".vue"
      ],
      "types": "^[ \\t]*export\\s+(?:default\\s+)?(?:declare\\s+)?(?:abstract\\s+)?(?:async\\s+)?(?P<kw>class|interface|function|const|let|var|type|enum)\\s+(?P<name>[A-Za-z_$][\\w$]*)",
      "members": "^\\s*(?:export\\s+)?(?:public\\s+|static\\s+|async\\s+|readonly\\s+|abstract\\s+|override\\s+)*(?:function\\s+)?(?P<name>[A-Za-z_$][\\w$]*)\\s*(?:<[^>]*>)?\\s*\\((?:[^()]|\\([^()]*\\))*\\)\\s*(?::\\s*[^={;]+)?\\s*[{;]",
      "skip": [
        "if",
        "for",
        "while",
        "switch",
        "catch",
        "return",
        "constructor",
        "function",
        "super",
        "new",
        "typeof",
        "else",
        "do",
        "try",
        "await",
        "import",
        "export"
      ],
      "callsLookLikeMembers": true,
      "decl": "^\\s*(?:export\\s+)?(?:default\\s+)?(?:(?:public|private|protected|static|async|readonly|abstract|override|function)\\s+)*(?P<name>[A-Za-z_$][\\w$]*)\\s*(?:<[^>]*>)?\\s*\\((?:[^()]|\\([^()]*\\))*\\)\\s*(?::\\s*[^={;]+)?\\s*\\{\\s*$"
    },
    "py": {
      "ext": [
        ".py"
      ],
      "types": "^(?P<kw>class|def)\\s+(?P<name>[A-Za-z_]\\w*)",
      "members": "\\s*(?:async\\s+)?(?:def|class)\\s+(?P<name>[A-Za-z_]\\w*)",
      "skipPrivate": true,
      "decl": "^\\s*(?:async\\s+)?def\\s+(?P<name>[A-Za-z_]\\w*)\\s*\\(",
      "indentScoped": true
    },
    "go": {
      "ext": [
        ".go"
      ],
      "types": "^(?P<kw>type|func)\\s+(?:\\([^)]*\\)\\s*)?(?P<name>[A-Z]\\w*)",
      "members": "^(?P<kw>type|func)\\s+(?:\\([^)]*\\)\\s*)?(?P<name>[A-Z]\\w*)",
      "decl": "^func\\s+(?:\\([^)]*\\)\\s*)?(?P<name>[A-Za-z_]\\w*)\\s*[\\[(]"
    }
  },
  "classify": [
    {
      "order": 10,
      "kind": "config",
      "name": "(?i)^(package\\-lock\\.json|npm\\-shrinkwrap\\.json|yarn\\.lock|pnpm\\-lock\\.yaml|bun\\.lock|bun\\.lockb|packages\\.lock\\.json|poetry\\.lock|uv\\.lock|pipfile\\.lock|pdm\\.lock|cargo\\.lock|go\\.sum|composer\\.lock|gemfile\\.lock|gradle\\.lockfile|flake\\.lock|mix\\.lock|pubspec\\.lock|package\\.resolved|\\.terraform\\.lock\\.hcl)$",
      "markGenerated": true
    },
    {
      "order": 20,
      "kind": "test",
      "path": "(?i)(^|/)(tests?|__tests__|specs?|e2e)/|\\.(unit|integration|e2e|functional|component)?tests?/"
    },
    {
      "order": 21,
      "kind": "test",
      "name": "(?i)([._-](test|tests|spec|stories)\\.[a-z]+$)|(^test_[^/]+\\.py$)|(_test\\.go$)"
    },
    {
      "order": 30,
      "kind": "migration",
      "path": "(?i)(^|/)(migrations?|dbmigrations|flyway|liquibase)/|(^|/)\\d{8,14}_[^/]+\\.(cs|sql|py|ts|js)$"
    },
    {
      "order": 40,
      "kind": "infra",
      "ext": [
        ".tf",
        ".tfvars",
        ".bicep",
        ".hcl"
      ]
    },
    {
      "order": 41,
      "kind": "infra",
      "code": false,
      "ui": false,
      "path": "(^|/)\\.github/workflows/|(^|/)(\\.azure|\\.pipelines|pipelines?|deploy|deployments?|helm|charts|k8s|kubernetes|infra|infrastructure)/|azure-pipelines[^/]*\\.ya?ml$|(^|/)dockerfile[^/]*$|(^|/)docker-compose[^/]*$"
    },
    {
      "order": 50,
      "kind": "config",
      "name": "(?i)^(\\.editorconfig|\\.gitignore|\\.gitattributes|\\.env.*|\\.?dockerignore|biome\\.jsonc?|renovate\\.json5?|\\.nvmrc|\\.node-version|\\.python-version|\\.tool-versions|makefile|justfile|\\.pre-commit-config\\.ya?ml|codeowners)$"
    },
    {
      "order": 50,
      "kind": "config",
      "ext": [
        ".config",
        ".yml",
        ".yaml",
        ".toml",
        ".ini",
        ".cfg",
        ".env",
        ".xml"
      ]
    },
    {
      "order": 51,
      "kind": "config",
      "path": "(^|/)\\.(vscode|devcontainer|idea)/"
    },
    {
      "order": 55,
      "kind": "infra",
      "ext": [
        ".ps1",
        ".sh",
        ".bash"
      ]
    },
    {
      "order": 60,
      "kind": "endpoint",
      "path": "(^|/)(controllers|endpoints|routes|functions)/[^/]+\\.(cs|ts|js|py)$"
    },
    {
      "order": 70,
      "kind": "ui",
      "ext": "@ui"
    },
    {
      "order": 70,
      "kind": "ui",
      "path": "(^|/)(components|pages|layouts)/"
    },
    {
      "order": 80,
      "kind": "dto",
      "code": true,
      "generated": true
    },
    {
      "order": 82,
      "kind": "entity",
      "ext": [
        ".sql"
      ]
    },
    {
      "order": 82,
      "kind": "entity",
      "code": true,
      "path": "(?i)(^|/)(domain|entities|entity|aggregates?|persistence|repositories)/|\\.domain/"
    },
    {
      "order": 90,
      "kind": "handler",
      "code": true
    }
  ],
  "flags": [
    {
      "type": "secret",
      "re": "(?i)\\b([\\w.-]*(?:password|passwd|secret|api_?key|account_?key|access_?key|connection_?string|sas_?token|token))[\\\"']?\\s*[:=]\\s*[\\\"']([^\\\"'\\s]{8,})[\\\"']",
      "on": "+",
      "severity": "high",
      "notKinds": [
        "ui",
        "test"
      ],
      "reason": "Possible secret literal near '{1}' (value not shown)",
      "safe": {
        "group": 2,
        "prefixes": [
          "UseDevelopmentStorage",
          "@Microsoft.KeyVault",
          "${",
          "var.",
          "http",
          "localhost",
          "<",
          "#{",
          "data."
        ]
      }
    },
    {
      "type": "secret",
      "re": "GetSecrets?(Async)?\\b|ListSecrets|listSecrets|ListKeys|listKeys|PrimaryKey|SecondaryKey|ClientSecret|SecretClient|SasToken|AccountKey",
      "on": "+",
      "severity": "medium",
      "codeOnly": true,
      "skipGenerated": true,
      "reason": "Code reads secrets or keys ({0})"
    },
    {
      "type": "security-sensitive",
      "on": "+-",
      "severity": "medium",
      "codeOnly": true,
      "skipGenerated": true,
      "re": "X-Forwarded-For|X-Real-IP|\\bForwarded\\b|RemoteAddr|Access-Control-Allow-Origin|AllowAnyOrigin|SameSite|Set-Cookie|\\bcsrf\\b|InsecureSkipVerify|verify\\s*=\\s*False|rejectUnauthorized\\s*:\\s*false|ValidateIssuer|ValidateAudience|ValidateLifetime|ValidateIssuerSigningKey|\\bJwtBearer\\b|\\bdangerouslySetInnerHTML\\b|\\binnerHTML\\s*=|bypassSecurityTrust\\w*|\\beval\\(",
      "reason": {
        "+": "Security-sensitive code added: {0}",
        "-": "Security-sensitive code removed or changed: {0}"
      }
    }
  ],
  "clientUrls": {
    "families": []
  },
  "context": {
    "docs": [
      "^README(\\.md)?$",
      "^AGENTS\\.md$",
      "^CLAUDE\\.md$",
      "^CONTRIBUTING\\.md$",
      "^ARCHITECTURE\\.md$",
      "^\\.github/copilot-instructions\\.md$",
      "(^|/)docs?/(adr|adrs|decisions)/[^/]+\\.md$",
      "(^|/)adr/[^/]+\\.md$",
      "(?i)^(DEVELOPMENT|DEVELOPING|HACKING|SECURITY)\\.md$",
      "(?i)^docs?/(development|architecture|contributing)[^/]*\\.md$"
    ],
    "projectDocs": [
      "README(\\.md)?$",
      "AGENTS\\.md$"
    ],
    "followLinks": true
  },
  "tickets": [
    {
      "re": "\\b([A-Z][A-Z0-9]+-\\d+)\\b"
    }
  ],
  "packageNames": []
}
